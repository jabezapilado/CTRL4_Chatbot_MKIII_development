# ==========================================
# Database Configuration
# ==========================================

CHATBOT_DB_HOST=127.0.0.1

# If your MySQL server uses a different port in your DB client, put it here.
CHATBOT_DB_PORT=3306

CHATBOT_DB_USER=root
CHATBOT_DB_PASSWORD=YOUR_DATABASE_PASSWORD
CHATBOT_DB_NAME=soc_chatbot
CHATBOT_DB_CHARSET=utf8mb4
CHATBOT_DB_SSL_CA=
CHATBOT_DB_SSL_VERIFY_CERT=false

# ==========================================
# Application Configuration
# ==========================================

# Supported values: development, production.
# Production requires a non-default secret key, Secure cookies, an explicit
# session directory, a log file, and a backup confirmation if migrations are
# intentionally enabled on startup.
CHATBOT_ENV=development
CHATBOT_DEBUG=true
CHATBOT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY
CHATBOT_PORT=5001

# Development keeps the existing automatic startup initialization behavior.
# Production defaults to false and should use scripts/setup_database.py after
# a verified backup. Set true only with CHATBOT_DATABASE_BACKUP_CONFIRMED=true.
CHATBOT_DATABASE_INITIALIZE_ON_START=true
CHATBOT_DATABASE_BACKUP_CONFIRMED=false

# ==========================================
# Server-side Sessions (single application instance)
# ==========================================

# CacheLib filesystem sessions are the only supported backend in this project.
# Do not run multiple application instances sharing this directory.
CHATBOT_SESSION_TYPE=cachelib
CHATBOT_SESSION_FILE_DIR=
CHATBOT_SESSION_FILE_THRESHOLD=500
CHATBOT_SESSION_COOKIE_SECURE=false

# ==========================================
# Logging
# ==========================================

# Defaults to backend/data/logs/ctrl4.log when blank. Use an absolute protected
# path in production; logs contain operational metadata only.
CHATBOT_LOG_LEVEL=INFO
CHATBOT_LOG_FILE=
CHATBOT_LOG_MAX_BYTES=5242880
CHATBOT_LOG_BACKUP_COUNT=5

# ==========================================
# Default Development Accounts
# ==========================================

# Optional account seeding for first-time setup.
# Leave blank to skip automatic account creation.

CHATBOT_SEED_STUDENT_EMAIL=student@hau.edu.ph
CHATBOT_SEED_STUDENT_NAME=Student User
CHATBOT_SEED_STUDENT_PASSWORD=student123

CHATBOT_SEED_STAFF_EMAIL=staff@hau.edu.ph
CHATBOT_SEED_STAFF_NAME=Guidance Staff
CHATBOT_SEED_STAFF_PASSWORD=staff123

CHATBOT_SEED_ADMIN_EMAIL=admin@hau.edu.ph
CHATBOT_SEED_ADMIN_NAME=System Administrator
CHATBOT_SEED_ADMIN_PASSWORD=admin123

# ==========================================
# Retrieval-Augmented Generation (RAG)
# ==========================================

# Leave blank to use the repository defaults. In production, configure
# protected deployment-storage paths and build/verify the index explicitly.
CHATBOT_RAG_DOCS_DIR=
CHATBOT_RAG_INDEX_DIR=
CHATBOT_RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-large
CHATBOT_RAG_TOP_K=5
CHATBOT_RAG_MIN_SCORE=0.30
CHATBOT_RAG_CHUNK_SIZE=700
CHATBOT_RAG_CHUNK_OVERLAP=120
CHATBOT_RAG_AUTO_BUILD_ON_START=true
CHATBOT_RAG_GENERATOR_MODEL=

# ==========================================
# Emotion Escalation
# ==========================================

CHATBOT_EMOTION_ESCALATION_ENABLED=true
CHATBOT_EMOTION_ESCALATION_THRESHOLD=0.55

# ==========================================
# Google Gemini
# ==========================================

CHATBOT_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
CHATBOT_GEMINI_MODEL=gemini-2.5-flash-lite
CHATBOT_GEMINI_TEMPERATURE=0.7
CHATBOT_GEMINI_MAX_OUTPUT_TOKENS=1024

# ==========================================
# Active LLM Provider
# ==========================================

# Supported values:
# - gemini
# - ollama

CHATBOT_LLM_PROVIDER=gemini

# ==========================================
# Ollama
# ==========================================

CHATBOT_OLLAMA_URL=http://localhost:11434/api/generate
CHATBOT_OLLAMA_MODEL=qwen2.5:7b
