# ==========================================
# Database Configuration
# ==========================================

CHATBOT_DB_HOST=127.0.0.1

# MySQL database port
CHATBOT_DB_PORT=3306

CHATBOT_DB_USER=root
CHATBOT_DB_PASSWORD=YOUR_DATABASE_PASSWORD
CHATBOT_DB_NAME=soc_chatbot
CHATBOT_DB_CHARSET=utf8mb4
CHATBOT_DB_SSL_CA=
CHATBOT_DB_SSL_VERIFY_CERT=false

# ==========================================
# Application Configuration
# ==========================================

CHATBOT_DEBUG=false

# Generate using:
# python -c "import secrets; print(secrets.token_hex(32))"
CHATBOT_SECRET_KEY=replace-with-generated-secret

CHATBOT_PORT=5001

# ==========================================
# Temporary Survey Student Registration
# ==========================================
# Keep disabled except during an approved survey window. The code belongs only
# in the VPS .env and must never be committed.
CHATBOT_STUDENT_SELF_REGISTRATION_ENABLED=false
CHATBOT_STUDENT_SELF_REGISTRATION_CODE=

# ==========================================
# Database Startup Safety
# ==========================================

# Development/local startup settings
CHATBOT_DATABASE_INITIALIZE_ON_START=true
CHATBOT_DATABASE_BACKUP_CONFIRMED=false

# ==========================================
# Server Sessions
# ==========================================

CHATBOT_SESSION_TYPE=cachelib
CHATBOT_SESSION_FILE_DIR=
CHATBOT_SESSION_FILE_THRESHOLD=500
CHATBOT_SESSION_COOKIE_SECURE=false

# ==========================================
# Logging
# ==========================================

CHATBOT_LOG_LEVEL=INFO
CHATBOT_LOG_FILE=
CHATBOT_LOG_MAX_BYTES=5242880
CHATBOT_LOG_BACKUP_COUNT=5

# ==========================================
# Default Development Accounts
# ==========================================

# Optional account seeding for first-time setup.
# Leave blank to skip automatic account creation.

CHATBOT_SEED_STUDENT_EMAIL=student@hau.edu.ph
CHATBOT_SEED_STUDENT_NAME=Student User
CHATBOT_SEED_STUDENT_NUMBER=2024-00000
CHATBOT_SEED_STUDENT_PASSWORD=YOUR_PASSWORD
CHATBOT_SEED_STUDENT_GENDER=Prefer not to say
CHATBOT_SEED_STUDENT_PROGRAM=BS Computer Science

CHATBOT_SEED_STUDENT2_EMAIL=
CHATBOT_SEED_STUDENT2_NAME=
CHATBOT_SEED_STUDENT2_NUMBER=
CHATBOT_SEED_STUDENT2_PASSWORD=
CHATBOT_SEED_STUDENT2_GENDER=
CHATBOT_SEED_STUDENT2_PROGRAM=

CHATBOT_SEED_STAFF_EMAIL=staff@hau.edu.ph
CHATBOT_SEED_STAFF_NAME=Guidance Staff
CHATBOT_SEED_STAFF_NUMBER=STF-0000
CHATBOT_SEED_STAFF_PASSWORD=YOUR_PASSWORD
CHATBOT_SEED_STAFF_GENDER=Prefer not to say

CHATBOT_SEED_STAFF2_EMAIL=
CHATBOT_SEED_STAFF2_NAME=
CHATBOT_SEED_STAFF2_NUMBER=
CHATBOT_SEED_STAFF2_PASSWORD=
CHATBOT_SEED_STAFF2_GENDER=

CHATBOT_SEED_ADMIN_EMAIL=admin@hau.edu.ph
CHATBOT_SEED_ADMIN_NAME=System Administrator
CHATBOT_SEED_ADMIN_PASSWORD=YOUR_PASSWORD
CHATBOT_SEED_ADMIN_GENDER=Prefer not to say

# ==========================================
# Retrieval-Augmented Generation (RAG)
# ==========================================

CHATBOT_RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-large
CHATBOT_RAG_TOP_K=5
CHATBOT_RAG_MIN_SCORE=0.30
CHATBOT_RAG_CHUNK_SIZE=700
CHATBOT_RAG_CHUNK_OVERLAP=120
CHATBOT_RAG_AUTO_BUILD_ON_START=true
CHATBOT_RAG_GENERATOR_MODEL=

# Optional custom paths
CHATBOT_RAG_DOCS_DIR=
CHATBOT_RAG_INDEX_DIR=

# ==========================================
# Emotion Escalation
# ==========================================

CHATBOT_EMOTION_ESCALATION_ENABLED=true
CHATBOT_EMOTION_ESCALATION_THRESHOLD=0.55

# ==========================================
# Google Gemini
# ==========================================

CHATBOT_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
CHATBOT_GEMINI_MODEL=gemini-2.5-flash-lite
CHATBOT_GEMINI_TEMPERATURE=0.7
CHATBOT_GEMINI_MAX_OUTPUT_TOKENS=1024

# Student chats finalize after this much time without another chat exchange.
# The VPS idle-finalizer timer uses the Flask secret unless you provide a
# separate private value here.
CHATBOT_STUDENT_CHAT_IDLE_TIMEOUT_SECONDS=1200
CHATBOT_STUDENT_CHAT_IDLE_FINALIZER_KEY=

# ==========================================
# Active LLM Provider
# ==========================================

# Supported values:
# - gemini
# - ollama

CHATBOT_LLM_PROVIDER=gemini

# ==========================================
# Ollama
# ==========================================

CHATBOT_OLLAMA_URL=http://localhost:11434/api/generate
CHATBOT_OLLAMA_MODEL=qwen2.5:7b
